# ═══════════════════════════════════════════════════════════
# KVM 监控系统 — 环境变量配置
# 复制本文件为 .env 并修改实际值
# ═══════════════════════════════════════════════════════════

# 数据库模式: "postgres" (生产) | "sqlite" (测试)
DB_MODE=postgres

# PostgreSQL 连接配置
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kvm_monitor
POSTGRES_USER=kvm_user
POSTGRES_PASSWORD=your_strong_password_here

# SQLite 路径 (仅 DB_MODE=sqlite 时生效)
SQLITE_PATH=kvm_test.db

# JWT 认证密钥 (必须更改为随机字符串!)
SECRET_KEY=replace_with_64_char_random_string_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# SNMP 配置
# 现场设备发送目标（Docker 宿主机）与后端容器监听端口分开配置。
SNMP_TRAP_HOST_PORT=162
SNMP_TRAP_LISTEN_PORT=10162
# 旧版 SNMP_TRAP_PORT 仍可作为后端监听端口兼容变量使用一版。
SNMP_DEFAULT_COMMUNITY=public
SNMP_HEALTH_POLL_ENABLED=true
SNMP_HEALTH_POLL_INTERVAL=1
SNMP_HEALTH_TIMEOUT=0.25
SNMP_HEALTH_RETRIES=1
SNMP_HEALTH_CONCURRENCY=20
SNMP_HEALTH_FAILURE_THRESHOLD=2
# 稳定在线探测合并后批量写库，不影响离线/恢复状态的即时提交。
SNMP_HEALTH_HEARTBEAT_FLUSH_INTERVAL=10
SNMP_ENDPOINT_STATUS_POLL_ENABLED=true
SNMP_ENDPOINT_STATUS_POLL_INTERVAL=5

# 后端服务
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# 初始管理员账号 (首次启动时自动创建)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_immediately
