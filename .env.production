# ═══════════════════════════════════════════════════════════════
# KVM Dashboard 生产环境配置模板
# 部署前请修改下方敏感值！
# ═══════════════════════════════════════════════════════════════

# ── 数据库 ──────────────────────────────────────────
DB_MODE=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kvm_monitor
POSTGRES_USER=kvm_user
POSTGRES_PASSWORD=123456

# ── 认证 ────────────────────────────────────────────
SECRET_KEY=abcdefghijkq
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── SNMP ────────────────────────────────────────────
SNMP_DEFAULT_COMMUNITY=public
# 现场设备向宿主机 UDP 162 发送 Trap，Docker 转发到容器 UDP 10162。
SNMP_TRAP_HOST_PORT=162
SNMP_TRAP_LISTEN_PORT=10162
# 旧版 SNMP_TRAP_PORT 仍可作为后端监听端口兼容变量使用一版。
# 完整轮询调度器每秒检查一次；实际执行间隔使用每台设备的 poll_interval。
# 轻量 sysObjectID 可达性探测：总断网/断电的交换机在约 1–2 秒内变更状态。
SNMP_HEALTH_POLL_ENABLED=true
SNMP_HEALTH_POLL_INTERVAL=1
SNMP_HEALTH_TIMEOUT=0.25
SNMP_HEALTH_RETRIES=1
SNMP_HEALTH_CONCURRENCY=20
SNMP_HEALTH_FAILURE_THRESHOLD=2
SNMP_HEALTH_HEARTBEAT_FLUSH_INTERVAL=10
# 仅查询 CPU/CON 状态列与 portTable 状态列；不假设物理端口与模块索引对应。
SNMP_ENDPOINT_STATUS_POLL_ENABLED=true
SNMP_ENDPOINT_STATUS_POLL_INTERVAL=5
# 原始 varbind 日志会快速增长；生产默认关闭。排障时可临时开启，且受以下轮转上限约束。
SNMP_RAW_LOG_ENABLED=false
SNMP_RAW_LOG_MAX_MB=10
SNMP_RAW_LOG_BACKUP_COUNT=5

# 时序数据、Trap 证据、审计记录的保留期；清理任务每天执行一次，不会在启动时删除历史数据。
DATA_RETENTION_CLEANUP_ENABLED=true
METRICS_RETENTION_DAYS=90
TRAP_EVENT_RETENTION_DAYS=180
AUDIT_LOG_RETENTION_DAYS=365
# 超过阈值时 /api/v1/health 会返回 database_capacity.warning=true。
DATABASE_SIZE_WARNING_MB=10240

# ── 日志 ────────────────────────────────────────────
LOG_LEVEL=INFO

# ── 时区 ────────────────────────────────────────────
TZ=Asia/Shanghai

# ── Web 端口（docker-compose 引用） ─────────────────
FRONTEND_PORT=80
