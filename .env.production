# ═══════════════════════════════════════════════════════════════
# KVM Dashboard 生产环境配置模板
# 部署前请修改下方敏感值！
# ═══════════════════════════════════════════════════════════════

# ── 数据库 ──────────────────────────────────────────
DB_MODE=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kvm_monitor
POSTGRES_USER=kvm_user
POSTGRES_PASSWORD=123456

# ── 认证 ────────────────────────────────────────────
SECRET_KEY=abcdefghijkq
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── SNMP ────────────────────────────────────────────
SNMP_DEFAULT_COMMUNITY=public
SNMP_TRAP_PORT=10162
# 完整指标 GET/WALK 轮询。不要为了设备失联检测降低此值。
SNMP_POLL_INTERVAL=45
# 轻量 sysObjectID 可达性探测：总断网/断电的交换机在约 1–2 秒内变更状态。
SNMP_HEALTH_POLL_ENABLED=true
SNMP_HEALTH_POLL_INTERVAL=1
SNMP_HEALTH_TIMEOUT=0.25
SNMP_HEALTH_RETRIES=1
SNMP_HEALTH_CONCURRENCY=20
SNMP_HEALTH_FAILURE_THRESHOLD=1
# 仅查询 CPU/CON 状态列与 portTable 状态列；不假设物理端口与模块索引对应。
SNMP_ENDPOINT_STATUS_POLL_ENABLED=true
SNMP_RAW_LOG_ENABLED=true

# ── 日志 ────────────────────────────────────────────
LOG_LEVEL=INFO

# ── 时区 ────────────────────────────────────────────
TZ=Asia/Shanghai

# ── Web 端口（docker-compose 引用） ─────────────────
FRONTEND_PORT=80
POSTGRES_PORT=5432
